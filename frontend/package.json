{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.cjs dev",
    "build": "node scripts/run-next.cjs build",
    "start": "node scripts/run-next.cjs start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi --input src/app/openapi.json --output src/api --client axios"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "axios": "^1.16.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.12.1",
    "lucide-react": "1.14.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.75.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "jsdom": "26.1.0",
    "openapi-typescript-codegen": "^0.30.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
