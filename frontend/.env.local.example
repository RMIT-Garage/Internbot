# Copy to .env.local for local dev against internbot-dev-ae3a3.
# Values: Terraform secret `firebase-web-config` in the dev GCP project, or Firebase console → Project settings → Your apps.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=internbot-dev-ae3a3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=internbot-dev-ae3a3
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=internbot-dev-ae3a3-storage
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Internbot

# Hosting origin — /api/** rewrites to Cloud Functions (same as production routing).
NEXT_PUBLIC_API_URL=https://internbot-dev-ae3a3.web.app

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
