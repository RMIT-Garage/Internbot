# Firebase web config
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-internbot
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-internbot.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=demo-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Internbot

# Backend API base URL. In production this is the Firebase Hosting origin,
# and Hosting rewrites /api/** to the Cloud Function (preserves the /api prefix
# that Express expects). The frontend is a static SPA that sends a Firebase
# ID token in `Authorization: Bearer <token>` on every request.
#
# Local dev — two options:
#   a) Hosting emulator (recommended, mirrors prod routing):
#      NEXT_PUBLIC_API_URL=http://localhost:5000
#   b) Functions emulator direct (bypasses Hosting rewrite; note the doubled
#      /api since GCP Functions strips the function name before Express):
#      NEXT_PUBLIC_API_URL=http://localhost:5001/demo-internbot/australia-southeast1/api
NEXT_PUBLIC_API_URL=http://localhost:5000

# Local dev
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
