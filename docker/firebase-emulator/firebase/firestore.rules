rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Internbot policy: the public Firebase web config (project ID + API key)
    // is shipped in the frontend bundle, so `firestore.googleapis.com` is
    // reachable by any holder of a valid Firebase ID token regardless of
    // what the frontend itself does. Anything we allow here is allowed for
    // the entire internet of authenticated tokens.
    //
    // We therefore default-deny EVERY collection. All reads and writes go
    // through the backend Express API, which uses the Admin SDK (rules are
    // bypassed for that path) and applies DTO redaction the rules language
    // cannot express (auth provider IDs, raw GPA, phone, etc.).
    //
    // Adding a new collection? Do NOT add an `allow` rule here — expose it
    // through a backend route instead. If a feature genuinely needs a
    // realtime client listener, that is a deliberate architectural change:
    // discuss before relaxing this default-deny posture.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
