# =============================================
# Firebase Admin SDK (SERVER ONLY)
# Generate: base64 -w 0 service-account.json
# Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# =============================================
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# =============================================
# Firebase Emulator (set true for local dev)
# =============================================
USE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8090
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# =============================================
# App
# =============================================
NODE_ENV=development
PORT=5001

# =============================================
# Dev-only auth convenience (NEVER set on production)
# =============================================
# When "true", the `enforceStudentEmail` blocking function marks every new
# account email-verified at sign-up, so testers skip the verification-email
# round-trip. Leave unset/false everywhere except dev — it disables the
# email-ownership gate that prevents student-number squatting.
AUTO_VERIFY_EMAIL=false

# =============================================
# RAG service (Interbot RAG API)
# =============================================
# Base URL of the RAG Cloud Function the `api` function proxies chat/FAQ
# requests to (POST {RAG_SERVER_URL}/v1/chat/message). Non-secret config: the
# endpoint is useless without the API key below. On deploy this is injected
# into the function's runtime env via CI — see docs/ENV-VARS.md.
RAG_SERVER_URL=https://australia-southeast1-internbotrag.cloudfunctions.net/api
#
# The RAG API key (Authorization: Bearer ibk_*) is a SECRET — never commit it,
# never expose it to the browser, and never put it in a .env file (dotenv values
# deploy as plaintext runtime env). It is managed as a runtime secret:
#   firebase functions:secrets:set RAG_API_KEY --project <id> --data-file=-
# and, for the emulator, placed as RAG_API_KEY=ibk_test_... in backend/.secret.local.
