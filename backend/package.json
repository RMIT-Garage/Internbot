{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:watch": "vitest --project integration",
    "test:component": "vitest run --project component",
    "test:component:watch": "vitest --project component",
    "test:coverage": "vitest run --coverage",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts && git diff --exit-code openapi.json",
    "auth:configure-password-policy": "tsx scripts/configure-password-policy.ts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.3.1",
    "firebase-admin": "13.7.0",
    "firebase-functions": "6.6.0",
    "helmet": "8.1.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.3.6",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-rate-limit": "6.0.2",
    "@types/node": "22.19.15",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
