{
  "openapi": "3.1.0",
  "info": {
    "title": "Internbot API",
    "version": "1.0.0",
    "description": "Backend workflow API for the Internbot internship platform. Source of truth: [WORKFLOW-API-SPEC.md](https://github.com/giatinhuynh/Internbot/blob/develop/docs/WORKFLOW-API-SPEC.md)."
  },
  "tags": [
    {
      "name": "Health",
      "description": "Public health probe."
    },
    {
      "name": "Authentication",
      "description": "Firebase identity sync."
    },
    {
      "name": "Users",
      "description": "Platform user records."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health probe",
        "description": "Public, unauthenticated. Returns 200 when the backend is serving requests.",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sync": {
      "post": {
        "operationId": "authSync",
        "summary": "Verify Firebase identity and return/create the platform user",
        "description": "On first call for a given `firebaseUid` creates a `users/{id}` document, sets `role: student`, and writes Firebase custom claims `{ platformUserId, role }`. Subsequent calls are idempotent. See WORKFLOW-API-SPEC.md §7.1.",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthSyncRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subsequent sync — the existing user is returned.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "201": {
            "description": "First sync — a new users/{id} document was created. Response includes `Location: /api/v1/users/{id}` and the full user body.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Canonical URL for the new user"
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Opaque version token"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — malformed body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Firebase ID token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "First-time sync missing the required `studentNumber`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "operationId": "getUser",
        "summary": "Return a platform user",
        "description": "Polymorphic response shape by role. Students may read only their own record; coordinators may read any. See WORKFLOW-API-SPEC.md §7.2.",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "example": "usr_aBc123XyZ",
              "description": "Platform user id. Accepts the alias `me` to target the caller."
            },
            "required": true,
            "description": "Platform user id. Accepts the alias `me` to target the caller."
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Firebase ID token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Student caller is not the owner of the requested user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No user exists with the supplied id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchUser",
        "summary": "Update the caller's student profile",
        "description": "Student-only. Top-level identity fields (`email`, `role`, `firebaseUid`, `status`, `onboardingStage`) are not writable. `profileStatus` is derived server-side. `studentProfile.studentNumber` is immutable after first sync. See WORKFLOW-API-SPEC.md §7.2.",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "example": "usr_aBc123XyZ",
              "description": "Platform user id. Accepts the alias `me` to target the caller."
            },
            "required": true,
            "description": "Platform user id. Accepts the alias `me` to target the caller."
          },
          {
            "in": "header",
            "name": "if-match",
            "schema": {
              "description": "Opt-in optimistic concurrency — the current ETag from a prior GET.",
              "type": "string"
            },
            "description": "Opt-in optimistic concurrency — the current ETag from a prior GET."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Body contains non-writable fields or violates `studentNumber` immutability.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Firebase ID token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Student caller is not the owner of the target user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Coordinator caller — coordinators have no writable user fields in v1. Response includes `Allow: GET`.",
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "412": {
            "description": "Client sent `If-Match` and it does not match the current ETag.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Semantic validation failure (empty body, missing required fields, etc.).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthSyncRequest": {
        "type": "object",
        "properties": {
          "studentNumber": {
            "example": "s1234567",
            "description": "Required on the first call (creates the student profile). Immutable after first-set; ignored on subsequent calls.",
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "example": "Alex Chen",
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "description": "Body for POST /api/v1/auth/sync. All fields optional on repeat calls."
      },
      "PatchUserRequest": {
        "type": "object",
        "properties": {
          "studentProfile": {
            "$ref": "#/components/schemas/StudentProfilePatch"
          }
        },
        "required": [
          "studentProfile"
        ],
        "additionalProperties": false,
        "description": "Body for PATCH /api/v1/users/:id. Top-level identity fields (email, role, firebaseUid, status, onboardingStage) are rejected with 400."
      },
      "StudentProfilePatch": {
        "type": "object",
        "properties": {
          "studentNumber": {
            "description": "Same value as first-sync is a no-op; a different value returns 400 `immutable_field`.",
            "type": "string",
            "minLength": 1
          },
          "programCode": {
            "example": "BP096",
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "academicInfo": {
            "description": "Replace the academic info block, or `null` to clear it (returns the profile to incomplete).",
            "anyOf": [
              {
                "$ref": "#/components/schemas/AcademicInfoRequest"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "AcademicInfoRequest": {
        "type": "object",
        "properties": {
          "programName": {
            "type": "string",
            "minLength": 1
          },
          "programLevel": {
            "type": "string",
            "enum": [
              "undergraduate",
              "postgraduate"
            ]
          },
          "unitsAttempted": {
            "type": "number",
            "minimum": 0
          },
          "creditUnitsEarned": {
            "type": "number",
            "minimum": 0
          },
          "gpa": {
            "type": "number",
            "minimum": 0,
            "maximum": 4,
            "description": "GPA on the RMIT /4.0 scale."
          },
          "currentStudyLoad": {
            "type": "string",
            "enum": [
              "full_time",
              "part_time",
              "unknown"
            ]
          },
          "programStatus": {
            "type": "string",
            "enum": [
              "active_in_program",
              "completed",
              "discontinued"
            ]
          },
          "majors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "programName",
          "programLevel",
          "unitsAttempted",
          "creditUnitsEarned",
          "gpa",
          "currentStudyLoad"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "status",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "UserResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/StudentUserResponse"
          },
          {
            "$ref": "#/components/schemas/CoordinatorUserResponse"
          }
        ],
        "description": "Polymorphic user record — shape depends on `role`.",
        "type": "object",
        "discriminator": {
          "propertyName": "role",
          "mapping": {
            "student": "#/components/schemas/StudentUserResponse",
            "coordinator": "#/components/schemas/CoordinatorUserResponse"
          }
        }
      },
      "StudentUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "usr_aBc123XyZ"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "blocked"
            ]
          },
          "onboardingStage": {
            "type": "string",
            "enum": [
              "profile_pending",
              "profile_complete"
            ]
          },
          "role": {
            "type": "string",
            "const": "student"
          },
          "currentWorkflowStep": {
            "$ref": "#/components/schemas/CurrentWorkflowStep"
          },
          "studentProfile": {
            "$ref": "#/components/schemas/StudentProfileResponse"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "status",
          "onboardingStage",
          "role",
          "currentWorkflowStep",
          "studentProfile"
        ],
        "additionalProperties": false,
        "description": "User record for role=student. Includes studentProfile and workflow step."
      },
      "CurrentWorkflowStep": {
        "type": "string",
        "enum": [
          "profile",
          "semester_selection",
          "opportunity_browsing",
          "offer_stage",
          "completed"
        ],
        "description": "Coarse routing-level workflow step derived from the student's profile and internship state (see WORKFLOW-API-SPEC.md §7.1)."
      },
      "StudentProfileResponse": {
        "type": "object",
        "properties": {
          "studentNumber": {
            "type": "string",
            "example": "s1234567"
          },
          "programCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "BP096"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "academicInfo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AcademicInfoResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "semesterId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "semesterSelectedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "profileStatus": {
            "type": "string",
            "enum": [
              "incomplete",
              "complete"
            ]
          }
        },
        "required": [
          "studentNumber",
          "programCode",
          "phone",
          "academicInfo",
          "profileStatus"
        ],
        "additionalProperties": false,
        "description": "Embedded student profile on a User response (see §8.2A)."
      },
      "AcademicInfoResponse": {
        "type": "object",
        "properties": {
          "programName": {
            "type": "string",
            "example": "Bachelor of Software Engineering (Professional)"
          },
          "programLevel": {
            "type": "string",
            "enum": [
              "undergraduate",
              "postgraduate"
            ]
          },
          "programStatus": {
            "type": "string",
            "enum": [
              "active_in_program",
              "completed",
              "discontinued"
            ]
          },
          "majors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unitsAttempted": {
            "type": "number",
            "example": 192
          },
          "creditUnitsEarned": {
            "type": "number",
            "example": 168
          },
          "gpa": {
            "type": "number",
            "example": 3.2,
            "description": "GPA on the RMIT /4.0 scale"
          },
          "currentStudyLoad": {
            "type": "string",
            "enum": [
              "full_time",
              "part_time",
              "unknown"
            ]
          },
          "notes": {
            "type": "string"
          },
          "confirmedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set once at first profile-complete transition; not rewritten on subsequent edits."
          }
        },
        "required": [
          "programName",
          "programLevel",
          "unitsAttempted",
          "creditUnitsEarned",
          "gpa",
          "currentStudyLoad",
          "confirmedAt"
        ],
        "additionalProperties": false,
        "description": "Confirmed academic information on a student profile (see §8.2B)."
      },
      "CoordinatorUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "usr_aBc123XyZ"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "blocked"
            ]
          },
          "onboardingStage": {
            "type": "string",
            "enum": [
              "profile_pending",
              "profile_complete"
            ]
          },
          "role": {
            "type": "string",
            "const": "coordinator"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "status",
          "onboardingStage",
          "role"
        ],
        "additionalProperties": false,
        "description": "User record for role=coordinator. Identity fields only, no studentProfile."
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://httpstatuses.io/403"
          },
          "title": {
            "type": "string",
            "example": "Forbidden"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "error"
        ],
        "additionalProperties": false,
        "description": "RFC 9457 Problem Details wrapped with the domain error envelope — see docs/ERROR-HANDLING.md."
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "bad_request",
              "unauthorized",
              "forbidden",
              "not_found",
              "method_not_allowed",
              "conflict",
              "precondition_failed",
              "validation_failed",
              "rate_limited",
              "service_unavailable",
              "internal_error"
            ],
            "description": "Coarse machine-readable code aligned to HTTP status class."
          },
          "reason": {
            "description": "Fine-grained sub-code for client UX branching (see WORKFLOW-API-SPEC.md §7.0).",
            "example": "student_not_owner",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorField"
            }
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "ErrorField": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "studentProfile.studentNumber"
          },
          "code": {
            "type": "string",
            "example": "immutable"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token",
        "description": "Firebase ID token obtained client-side. Platform identity (`platformUserId`, `role`) is read from custom claims; see docs/WORKFLOW-API-SPEC.md §7.0."
      }
    }
  }
}
