# LOCAL DEV ONLY. In CI/CD, env-specific values come from envs/{dev,prod}.tfvars
# (committed). github_repository and github_repository_id come from GitHub Actions
# context (TF_VAR_* set in _terraform.yml).
#
# Copy to terraform.tfvars and fill in values to run `terraform plan` locally.
# terraform.tfvars is gitignored — never commit it.

project_id           = "internbot-dev-ae3a3"
github_repository    = "giatinhuynh/Internbot"
github_repository_id = "1187697443"

# Empty list = any branch can impersonate the deploy SA.
# For prod, use: github_allowed_refs = ["refs/heads/main"]
github_allowed_refs = ["refs/heads/develop"]
